# .env.secret.template — user-supplied provider credentials (SAA-836 S1, gate C)
#
# Copy this file to `.env.secret` and fill in real values. The `.env.secret`
# file is git-ignored and must NEVER be committed. The mastra engine fails
# closed without a resolvable credential: no model traffic is attempted.
#
# The mastra environment reads the credential by NAME from
# MASTRA__CREDENTIALS__API_KEY_ENV (default below); only the referenced
# variable's presence is asserted — secret values are never held by the graph
# layer.

# Provider credential consumed by the model router at call time.
MASTRA_PROVIDER_API_KEY=

# Langfuse credentials for the mastra engine's observability layer
# (SAA-836 O1). The observability lane is enabled by default
# (MASTRA__OBSERVABILITY__ENABLED) and exports every engine trace to the
# deployed langfuse target (MASTRA__OBSERVABILITY__LANGFUSE__ENDPOINT, .env,
# non-secret). The credential variable NAMES can be overridden with
# MASTRA__OBSERVABILITY__LANGFUSE__PUBLIC_KEY_ENV / _SECRET_KEY_ENV (.env).
# The mastra observability layer fails closed without them: no unauthenticated
# trace export is attempted.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Eval suite (test-only, optional): `npm run test:evals` reads PDM_AI_API_KEY
# for the live pipeline-smoke eval; the eval self-skips when it is absent.
PDM_AI_API_KEY=
