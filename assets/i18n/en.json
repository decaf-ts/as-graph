            "output": {
              "payload": {
                "label": "Payload"
              }
            }
          }
        },
        "webhook": {
          "name": "Webhook trigger",
          "description": "Starts the workflow when an HTTP request is received on the configured path and method.",
          "ports": {
            "input": {
              "schema": {
                "label": "Request schema",
                "placeholder": "Define the expected request body"
              }
            },
            "output": {
              "payload": {
                "label": "Payload"
              }
            }
          },
          "fields": {
            "schema": {
              "label": "Request schema",
              "placeholder": "Define the expected request body"
            }
          }
        },
        "schedule": {
          "name": "Schedule trigger",
          "description": "Starts the workflow on a cron-like schedule with timezone support.",
          "ports": {
            "input": {
              "cron": {
                "label": "Schedule",
                "placeholder": "0 * * * *"
