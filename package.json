{
  "name": "@decaf-ts/as-graph",
  "version": "0.6.0",
  "description": "Workflow document model, node catalogue and reference execution engine for Decaf graph workflows",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/types/index.d.mts",
        "default": "./lib/esm/index.js"
      },
      "require": {
        "types": "./lib/types/index.d.cts",
        "default": "./lib/cjs/index.cjs"
      },
      "default": "./lib/esm/index.js"
    },
    "./shared": {
      "import": {
        "types": "./lib/types/shared/index.d.mts",
        "default": "./lib/esm/shared/index.js"
      },
      "require": {
        "types": "./lib/types/shared/index.d.cts",
        "default": "./lib/cjs/shared/index.cjs"
      },
      "default": "./lib/esm/shared/index.js"
    },
    "./nest": {
      "import": {
        "types": "./lib/types/nest/index.d.mts",
        "default": "./lib/esm/nest/index.js"
      },
      "require": {
        "types": "./lib/types/nest/index.d.cts",
        "default": "./lib/cjs/nest/index.cjs"
      },
      "default": "./lib/esm/nest/index.js"
    },
    "./ram": {
      "import": {
        "types": "./lib/types/ram/index.d.mts",
        "default": "./lib/esm/ram/index.js"
      },
      "require": {
        "types": "./lib/types/ram/index.d.cts",
        "default": "./lib/cjs/ram/index.cjs"
      },
      "default": "./lib/esm/ram/index.js"
    },
    "./typeorm": {
      "import": {
        "types": "./lib/types/typeorm/index.d.mts",
        "default": "./lib/esm/typeorm/index.js"
      },
      "require": {
        "types": "./lib/types/typeorm/index.d.cts",
        "default": "./lib/cjs/typeorm/index.cjs"
      },
      "default": "./lib/esm/typeorm/index.js"
    },
    "./mastra": {
      "import": {
        "types": "./lib/types/mastra/index.d.mts",
        "default": "./lib/esm/mastra/index.js"
      },
      "require": {
        "types": "./lib/types/mastra/index.d.cts",
        "default": "./lib/cjs/mastra/index.cjs"
      },
      "default": "./lib/esm/mastra/index.js"
    },
    "./dagster": {
      "import": {
        "types": "./lib/types/dagster/index.d.mts",
        "default": "./lib/esm/dagster/index.js"
      },
      "require": {
        "types": "./lib/types/dagster/index.d.cts",
        "default": "./lib/cjs/dagster/index.cjs"
      },
      "default": "./lib/esm/dagster/index.js"
    }
  },
  "main": "./lib/cjs/index.cjs",
  "module": "./lib/esm/index.js",
  "types": "./lib/types/index.d.mts",
  "bin": {
    "as-graph-server": "./lib/cjs/nest/graph/main.cjs"
  },
  "sideEffects": false,
  "scripts": {
    "do-install": "NPM_TOKEN=$(cat .npmtoken) npm install",
    "update-dependencies": "PREFIX=\"decaf-ts\"; npm ls | grep \"$PREFIX\" | awk -F/ '{print $NF}' | sed 's/@.*//' | xargs -I package npm update @\"$PREFIX\"/package",
    "update-scripts": "npx update-scripts",
    "sync-codex": "./bin/sync-codex.sh",
    "codex": "codex -s workspace-write exec",
    "release": "./bin/tag-release.sh",
    "on-first-run": "npx update-scripts --boot",
    "set-git-auth": "decaf utils credentials git-helper",
    "flash-forward": "npx npm-check-updates -u && npm run do-install",
    "reset": "rm -rf * && git checkout . && git pull && npm run do-install",
    "build": "build-scripts --dev",
    "build:prod": "build-scripts --prod",
    "check:emitted-specifiers": "node ./scripts/check-emitted-relative-specifiers.mjs",
    "postbuild": "npm run check:emitted-specifiers",
    "postbuild:prod": "npm run check:emitted-specifiers",
    "start:backend": "node ./lib/cjs/nest/graph/main.cjs",
    "start:backend:local": "GRAPH_BACKEND_ENGINE=local node ./lib/cjs/nest/graph/main.cjs",
    "start:backend:mastra": "GRAPH_BACKEND_ENGINE=mastra node ./lib/cjs/nest/graph/main.cjs",
    "start:backend:dagster": "GRAPH_BACKEND_ENGINE=dagster node ./lib/cjs/nest/graph/main.cjs",
    "test": "npm run test:all",
    "test:unit": "jest --testPathPatterns=\"/tests/unit\" --passWithNoTests --detectOpenHandles",
    "test:integration": "jest --testPathPatterns=\"/tests/(integration)\" --passWithNoTests --detectOpenHandles",
    "test:integration:standard": "jest --testPathPatterns=\"/tests/integration/graph\" --passWithNoTests --detectOpenHandles",
    "test:integration:backend": "jest --testPathPatterns=\"/tests/integration/nest\" --passWithNoTests --detectOpenHandles",
    "test:integration:mastra": "jest --testPathPatterns=\"/tests/integration/mastra\" --passWithNoTests --detectOpenHandles",
    "test:integration:dagster": "bash tests/integration/dagster/run.sh",
    "test:e2e": "jest --testPathPatterns=\"/tests/(e2e)\" --passWithNoTests --detectOpenHandles",
    "test:all": "jest --testPathPatterns=\"/tests\" --passWithNoTests --detectOpenHandles",
    "test:evals": "jest -c jest.eval.config.cjs --passWithNoTests --detectOpenHandles",
    "test:dist": "TEST_TARGET=lib npm run test:all && TEST_TARGET=dist npm run test:all",
    "test:circular": "dpdm -T --no-warning --no-tree ./src/index.ts",
    "prepare-it-tests": "bash scripts/prepare-it-tests.sh",
    "teardown-it-tests": "bash tests/integration/dagster/run.sh down",
    "coverage": "rimraf ./workdocs/reports/data/*.json && npm run test:all -- --coverage --config=./workdocs/reports/jest.coverage.config.cjs",
    "lint": "eslint .",
    "lint-fix": "eslint --fix .",
    "prepare-pr": "npm run lint-fix && npm run build:prod && npm run coverage && npm run docs",
    "prepare-release": "npm run lint-fix && npm run build:prod && npm run coverage && npm run test:dist && npm run docs",
    "repo:init": "codex exec \"$(cat ./.codex/prompts/repo-setup.md)\nbase_path is `./`, initialize the repository\" -s workspace-write",
    "repo:setup": "codex exec \"$(cat ./.codex/prompts/repo-setup.md)\nbase_path is ./\" -s workspace-write",
    "repo:doc": "codex exec \"$(cat ./.codex/prompts/doc.md) $(cat ./.codex/prompts/bulk-docs.md)\nbase_path is ./\" -s workspace-write",
    "repo:tests": "codex exec \"$(cat ./.codex/prompts/bulk-tests.md)\nbase_path is ./ and coverage is 95%\" -s workspace-write",
    "repo:readme": "codex exec \"$(cat ./.codex/prompts/update-readme.md)\nbase_path is ./\" -s workspace-write",
    "repo:pr": "npm run repo:doc && npm run repo:tests && npm run repo:readme",
    "drawings": "for FILE in workdocs/drawings/*.drawio; do echo \"converting $FILE to image...\" && docker run --rm -v $(pwd):/data rlespinasse/drawio-export --format png $FILE; done && cp -rf workdocs/drawings/export/* workdocs/resources/",
    "uml": "cd workdocs/uml && for FILE in ./*.puml; do docker run --rm -v $(pwd):/work -w /work miy4/plantuml -DPLANTUML_LIMIT_SIZE=8192 -tpng $FILE; done && cd ../.. && cp -fr workdocs/uml/*.png workdocs/resources/",
    "docs": "npx rimraf ./docs && mkdir docs && build-scripts --docs",
    "publish-docs": "docker run -it --rm --user $(id -u):$(id -g) -v \"$(pwd)/workdocs/confluence:/content\" -e ATLASSIAN_API_TOKEN=\"$(DECAF_BANNER=false decaf utils credentials get --name confluence --logLevel error)\" ghcr.io/markdown-confluence/publish:latest",
    "docker:login": "docker login ghcr.io -u \"$(DECAF_BANNER=false decaf utils credentials get --name docker-user --legacy-file .dockeruser --logLevel error)\" -p \"$(DECAF_BANNER=false decaf utils credentials get --name docker --legacy-file .dockertoken --logLevel error)\"",
    "docker:build": "npm run docker:build-base",
    "docker:build-base": "NPM_TOKEN=\"$(DECAF_BANNER=false decaf utils credentials get --name npm --logLevel error)\" DOCKER_BUILDKIT=1 docker build --secret id=TOKEN,env=NPM_TOKEN -t ghcr.io/decaf-ts/ts-workspace:base-$(cat package.json | jq -r '.version') -t ghcr.io/decaf-ts/ts-workspace:base-${VERSION:-latest} -f ./Dockerfile .",
    "docker:publish": "npm run docker:publish-base",
    "docker:publish-base": "docker push ghcr.io/decaf-ts/ts-workspace:base-$(cat package.json | jq -r '.version') && docker push ghcr.io/decaf-ts/ts-workspace:base-${VERSION:-latest}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decaf-ts/ts-workspace.git"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "files": [
    "lib",
    "dist",
    "assets",
    "!lib/cjs/workflows",
    "!lib/esm/workflows",
    "!lib/types/workflows"
  ],
  "keywords": [
    "graph",
    "workflow",
    "workflow-engine",
    "execution-engine",
    "node-graph",
    "dag",
    "pipeline",
    "orchestration",
    "decaf-ts",
    "nestjs",
    "typescript",
    "ts"
  ],
  "author": "Tiago Venceslau",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/decaf-ts/as-graph/issues"
  },
  "homepage": "https://github.com/decaf-ts/as-graph#readme",
  "dagster": {
    "distribution": "dagster",
    "pinnedVersion": "1.13.25",
    "source": "https://pypi.org/pypi/dagster/json",
    "note": "Dagster is a Python orchestration engine with no official JavaScript runtime. This pin records the engine contract the generated ./dagster artifacts target; execution is driven through the host-injected DagsterClient port."
  },
  "dependencies": {
    "@decaf-ts/as-zod": "latest",
    "@decaf-ts/crypto": "latest",
    "@decaf-ts/db-decorators": "latest",
    "@decaf-ts/decoration": "latest",
    "@decaf-ts/decorator-validation": "latest",
    "@decaf-ts/for-http": "latest",
    "@decaf-ts/for-nest": "latest",
    "@decaf-ts/for-typeorm": "latest",
    "@decaf-ts/integrations": "latest",
    "@decaf-ts/ui-decorators": "latest",
    "@mastra/langfuse": "^1.6.1",
    "@mastra/observability": "^1.20.1",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@nestjs/platform-express": "^11.2.6",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "acorn": "^8.18.0",
    "acorn-walk": "^8.3.5",
    "elkjs": "^0.12.0",
    "isolated-vm": "^6.2.0",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^2.0.62",
    "@decaf-ts/utils": "^1.14.0",
    "@nestjs/testing": "^11.2.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jsdoc": "^4.0.4",
    "jsdoc-mermaid": "^1.0.0",
    "markdown-include": "^0.4.3",
    "rimraf": "^6.0.1",
    "supertest": "^7.3.0"
  },
  "peerDependencies": {
    "@mastra/core": "^1.77.0",
    "@mastra/libsql": "^1.26.2",
    "@mastra/memory": "^1.38.0",
    "@mastra/pg": "^1.31.2"
  },
  "overrides": {
    "js-yaml": "^5.2.2",
    "gray-matter": {
      "js-yaml": "^3.13.1"
    }
  }
}
